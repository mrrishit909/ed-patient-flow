  "/v1/recommendations/{rec_id}/approve": {
   "post": {
    "tags": [
     "recommendations"
    ],
    "summary": "An operations director approves (or rejects) a proposed recommendation; only then do its actions count in the capacity view and later simulations",
    "operationId": "approve_v1_recommendations__rec_id__approve_post",
    "parameters": [
     {
      "name": "rec_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "format": "uuid",
       "title": "Rec Id"
      }
     },
     {
      "name": "decision",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "approved",
        "rejected"
       ],
       "type": "string",
       "default": "approved",
       "title": "Decision"
      }
     },
     {
      "name": "Idempotency-Key",
      "in": "header",
