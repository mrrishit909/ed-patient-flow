 "components": {
  "schemas": {
   "Actions": {
    "properties": {
     "surge_beds": {
      "type": "integer",
      "maximum": 12.0,
      "minimum": 0.0,
      "title": "Surge Beds",
      "default": 0
     },
     "extra_nurses": {
      "additionalProperties": {
       "type": "integer"
      },
      "propertyNames": {
       "enum": [
        "day",
        "evening",
        "night"
       ]
      },
      "type": "object",
      "title": "Extra Nurses"
     },
     "discharge_push": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 3.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Discharge Push",
      "description": "ward discharge processing multiplier"
     }
    },
    "type": "object",
    "title": "Actions"
   },
   "AdvanceIn": {
    "properties": {
     "hours": {
      "type": "integer",
      "maximum": 24.0,
      "minimum": 1.0,
      "title": "Hours"
     },
     "surge": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Surge"
       },
       {
        "type": "null"
       }
      ]
     },
     "slowdown": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Slowdown"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object",
    "required": [
     "hours"
    ],
    "title": "AdvanceIn"
   },
   "Constraint": {
    "properties": {
     "discharge_slowdown_factor": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.1,
      "title": "Discharge Slowdown Factor"
     },
     "hours": {
      "type": "integer",
      "maximum": 24.0,
      "minimum": 1.0,
      "title": "Hours"
     }
    },
    "type": "object",
    "required": [
     "discharge_slowdown_factor",
     "hours"
    ],
    "title": "Constraint"
   },
   "FhirIn": {
    "properties": {
     "resourceType": {
      "type": "string",
      "const": "Bundle",
      "title": "Resourcetype"
     },
     "entry": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "maxItems": 200,
      "minItems": 1,
      "title": "Entry"
     }
    },
    "type": "object",
    "required": [
     "resourceType",
     "entry"
    ],
    "title": "FhirIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 17
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "SimIn": {
    "properties": {
     "hours": {
      "type": "integer",
      "maximum": 24.0,
      "minimum": 2.0,
      "title": "Hours",
      "default": 12
     },
     "runs": {
      "type": "integer",
      "maximum": 100.0,
      "minimum": 5.0,
      "title": "Runs",
      "default": 30
     },
     "actions": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Actions"
       },
       {
        "type": "null"
       }
      ]
     },
     "known_constraints": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Constraint"
       },
       {
        "type": "null"
       }
      ],
      "description": "what bed management has announced, such as a discharge slowdown"
     },
     "include_approved_actions": {
      "type": "boolean",
      "title": "Include Approved Actions",
      "default": true
     }
    },
    "type": "object",
    "title": "SimIn"
   },
   "Slowdown": {
    "properties": {
     "from_minutes": {
      "type": "integer",
      "maximum": 720.0,
      "minimum": 0.0,
      "title": "From Minutes"
     },
     "hours": {
      "type": "integer",
      "maximum": 24.0,
      "minimum": 1.0,
      "title": "Hours"
     },
     "factor": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.1,
      "title": "Factor",
      "description": "ward discharge processing rate, 1 = normal"
     }
    },
    "type": "object",
    "required": [
     "from_minutes",
     "hours",
     "factor"
    ],
    "title": "Slowdown"
   },
   "StaffIn": {
    "properties": {
     "hours": {
      "type": "integer",
      "maximum": 24.0,
      "minimum": 4.0,
      "title": "Hours",
      "default": 16
     },
     "runs": {
      "type": "integer",
      "maximum": 100.0,
      "minimum": 5.0,
      "title": "Runs",
      "default": 30
     },
     "known_constraints": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Constraint"
       },
       {
        "type": "null"
       }
      ]
     },
     "max_call_ins_per_shift": {
      "type": "integer",
